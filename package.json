{
  "name": "social-git",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate:openapi": "node scripts/generate-openapi.ts",
    "test": "node --test --test-reporter=spec packages/*/test/*.test.js && node --test test/*.test.ts",
    "test:api": "node --test test/*.test.ts",
    "test:core": "node --test --test-reporter=spec packages/core/test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
